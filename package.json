{
  "name": "dsh-xueqiu",
  "version": "1.2.1",
  "description": "雪球 mini 行情面板 — DeepSeek Harness 免登录 A股/港美股实时行情、K线(蜡烛/成交量/均线)、分时图、热榜、搜索、7x24 快讯、热议用户。可拖拽悬浮面板，交易时段智能刷新。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "xueqiu",
    "雪球",
    "stock",
    "a-share",
    "finance"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client/index.js",
    "./dynamic/*": "./dynamic/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.6",
    "react": "^18.3.1"
  },
  "files": [
    "src/index.js",
    "src/client/index.js",
    "dynamic/host.js",
    "dynamic/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}